#: crates/av1-convert/src/analyze.rs:302
msgid "cropdetect produced no usable measurement"
msgstr "cropdetect hat keine brauchbare Messung geliefert"

#: crates/av1-convert/src/analyze.rs:304
msgid "the sampled crop rectangles disagree"
msgstr "die gemessenen Beschnitt-Rechtecke widersprechen sich"

#: crates/av1-convert/src/analyze.rs:306
msgid "the crop rectangle is not even on all sides"
msgstr "das Beschnitt-Rechteck ist nicht auf allen Seiten gerade"

#: crates/av1-convert/src/analyze.rs:308
msgid "there is nothing worth cropping"
msgstr "es gibt nichts, das sich zu beschneiden lohnt"

#: crates/av1-convert/src/analyze.rs:375
msgid "idet reported nothing, assuming progressive"
msgstr "idet hat nichts gemeldet, es wird von progressiv ausgegangen"

#: crates/av1-convert/src/analyze.rs:387
#, rust-format
msgid "repeated fields at {rate} fps: telecine outside NTSC is not handled"
msgstr ""
"wiederholte Halbbilder bei {rate} fps: Telecine außerhalb von NTSC wird "
"nicht behandelt"

#: crates/av1-convert/src/analyze.rs:403
#, rust-format
msgid "no crop: {reason} ({share} % of {count} measurements)"
msgstr "kein Beschnitt: {reason} ({share} % von {count} Messungen)"

#: crates/av1-convert/src/defaults.rs:63 crates/av1-convert/src/main.rs:280
msgid "Quality, lower is better"
msgstr "Qualität, kleiner ist besser"

#: crates/av1-convert/src/defaults.rs:68 crates/av1-convert/src/main.rs:286
msgid "Transcode the audio to Opus, 256 kb/s"
msgstr "Ton nach Opus umkodieren, 256 kb/s"

#: crates/av1-convert/src/defaults.rs:73 crates/av1-convert/src/main.rs:292
msgid "Encode 10 bit instead of 8"
msgstr "Mit 10 Bit statt 8 Bit kodieren"

#: crates/av1-convert/src/defaults.rs:78
msgid "Crop even with subtitles (they then sit misplaced)"
msgstr "Auch bei Untertiteln beschneiden (sie sitzen dann verschoben)"

#: crates/av1-convert/src/defaults.rs:83
msgid "Audio tracks (deu,eng or all)"
msgstr "Tonspuren (deu,eng oder all)"

#: crates/av1-convert/src/defaults.rs:88
msgid "Subtitles (auto, all, none or deu,eng)"
msgstr "Untertitel (auto, all, none oder deu,eng)"

#: crates/av1-convert/src/defaults.rs:133
msgid "AV1 default settings"
msgstr "AV1-Standardeinstellungen"

#: crates/av1-convert/src/defaults.rs:134
msgid "What av1-convert encodes with when nothing else is given:"
msgstr "Womit av1-convert konvertiert, wenn nichts anderes angegeben ist:"

#: crates/av1-convert/src/defaults.rs:168
#, rust-format
msgid "The config file cannot be read and stays unchanged - {reason}"
msgstr ""
"Die Konfigurationsdatei kann nicht gelesen werden und bleibt unverändert – "
"{reason}"

#: crates/av1-convert/src/defaults.rs:183
#, rust-format
msgid "Saved: {path}"
msgstr "Gespeichert: {path}"

#: crates/av1-convert/src/defaults.rs:195
#, rust-format
msgid "Nothing saved, the settings window failed - {reason}"
msgstr ""
"Nichts gespeichert, das Einstellungsfenster ist fehlgeschlagen – {reason}"

#: crates/av1-convert/src/main.rs:66
msgid "AV1 conversion"
msgstr "AV1-Konvertierung"

#: crates/av1-convert/src/main.rs:104
msgid "AV1 conversion interrupted"
msgstr "AV1-Konvertierung unterbrochen"

#: crates/av1-convert/src/main.rs:105
msgid "The partial file was removed, the source is untouched."
msgstr "Die unfertige Datei wurde entfernt, die Quelldatei ist unberührt."

#: crates/av1-convert/src/main.rs:126
#, rust-format
msgid "Nothing converted, the settings window failed - {reason}"
msgstr ""
"Nichts konvertiert, das Einstellungsfenster ist fehlgeschlagen – {reason}"

#: crates/av1-convert/src/main.rs:140 crates/av1-convert/src/main.rs:330
msgid "Convert to AV1"
msgstr "Zu AV1 konvertieren"

#: crates/av1-convert/src/main.rs:153
#, rust-format
msgid "The config file was ignored, the built-in defaults apply - {reason}"
msgstr ""
"Die Konfigurationsdatei wurde ignoriert, es gelten die eingebauten Vorgaben "
"– {reason}"

#: crates/av1-convert/src/main.rs:172
#, rust-format
msgid "{file}: failed - {reason}"
msgstr "{file}: fehlgeschlagen – {reason}"

#: crates/av1-convert/src/main.rs:207
#, rust-format
msgid "{count} file"
msgid_plural "{count} files"
msgstr[0] "{count} Datei"
msgstr[1] "{count} Dateien"

#: crates/av1-convert/src/main.rs:217
#, rust-format
msgid "{count} file done"
msgid_plural "{count} files done"
msgstr[0] "{count} Datei fertig"
msgstr[1] "{count} Dateien fertig"

#: crates/av1-convert/src/main.rs:224
#, rust-format
msgid "{failed} of {count} file failed"
msgid_plural "{failed} of {count} files failed"
msgstr[0] "{failed} von {count} Datei fehlgeschlagen"
msgstr[1] "{failed} von {count} Dateien fehlgeschlagen"

#: crates/av1-convert/src/main.rs:251
msgid "DVD film"
msgstr "DVD-Film"

#: crates/av1-convert/src/main.rs:252
msgid "Camera or noisy footage"
msgstr "Kamera oder verrauschtes Material"

#: crates/av1-convert/src/main.rs:253
msgid "Archive"
msgstr "Archiv"

#: crates/av1-convert/src/main.rs:254
msgid "Save space"
msgstr "Platz sparen"

#: crates/av1-convert/src/main.rs:255
msgid "Custom"
msgstr "Benutzerdefiniert"

#: crates/av1-convert/src/main.rs:272
msgid "Preset"
msgstr "Vorlage"

#: crates/av1-convert/src/main.rs:331
msgid "How should it be encoded?"
msgstr "Wie soll kodiert werden?"

#: crates/av1-convert/src/main.rs:353
msgid "there is no video stream"
msgstr "sie enthält keine Videospur"

#: crates/av1-convert/src/main.rs:363
msgid "it is already AV1"
msgstr "sie ist bereits AV1"

#: crates/av1-convert/src/main.rs:379
#, rust-format
msgid ""
"every audio track kept: none of them is {langs}, and a file without audio "
"would be worse than a large one"
msgstr ""
"alle Tonspuren behalten: keine davon ist {langs}, und eine Datei ohne Ton "
"wäre schlimmer als eine große"

#: crates/av1-convert/src/main.rs:394
#, rust-format
msgid ""
"cropped anyway: the {count} subtitle stream(s) will sit misplaced, their "
"bitmaps belong to the uncropped frame"
msgstr ""
"trotzdem beschnitten: die {count} Untertitelspur(en) sitzen verschoben, ihre "
"Bitmaps gehören zum unbeschnittenen Bild"

#: crates/av1-convert/src/main.rs:404
#, rust-format
msgid ""
"no crop: {count} subtitle stream(s) are kept, and their bitmaps are placed "
"in the uncropped frame"
msgstr ""
"kein Beschnitt: {count} Untertitelspur(en) bleiben erhalten, und ihre "
"Bitmaps liegen im unbeschnittenen Bild"

#: crates/av1-convert/src/main.rs:419
#, rust-format
msgid "{file}: {warning}"
msgstr "{file}: {warning}"

#. i18n: {plan} is the technical line the log carries too - "deinterlace, crop 704x448, cq 28"
#: crates/av1-convert/src/main.rs:511
#, rust-format
msgid "{file}: converting - {plan}"
msgstr "{file}: wird konvertiert – {plan}"

#: crates/av1-convert/src/main.rs:549
#, rust-format
msgid "{file}: cancelled, the partial file was removed"
msgstr "{file}: abgebrochen, die unfertige Datei wurde entfernt"

#: crates/av1-convert/src/main.rs:555
msgid "Cancelled"
msgstr "Abgebrochen"

#: crates/av1-convert/src/main.rs:572
#, rust-format
msgid "{file}: the AV1 file is larger than the source, both were kept"
msgstr "{file}: die AV1-Datei ist größer als die Quelle, beide wurden behalten"

#. i18n: {change} reads "4.27 GiB -> 1.23 GiB (-71 %)"
#: crates/av1-convert/src/main.rs:585
#, rust-format
msgid "{file}: done, {change}"
msgstr "{file}: fertig, {change}"

#: crates/av1-convert/src/main.rs:613
#, rust-format
